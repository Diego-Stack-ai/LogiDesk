rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzione helper per controllare autenticazione
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regola di default chiusa
    match /{document=**} {
      allow read, write: if false;
    }

    // Funzione helper per verificare se utente e' amministratore o impiegata con privilegi elevati
    function isAdmin() {
      let userData = get(/databases/$(database)/documents/aziende/NzXaCgyXxZWWehw1tSlo/utenti/$(request.auth.uid)).data;
      return userData.ruolo == 'amministratore' || (userData.ruolo == 'impiegata' && userData.canElevate == true);
    }

    // Funzione helper per verificare se utente e' impiegata base
    function isImpiegata() {
      return get(/databases/$(database)/documents/aziende/NzXaCgyXxZWWehw1tSlo/utenti/$(request.auth.uid)).data.ruolo == 'impiegata';
    }

    // Funzione helper per verificare se utente e' soel
    function isSoel() {
      return get(/databases/$(database)/documents/aziende/NzXaCgyXxZWWehw1tSlo/utenti/$(request.auth.uid)).data.ruolo == 'soel';
    }

    match /aziende/{companyId}/utenti/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isImpiegata() || isSoel());
      allow create: if false;
      allow delete: if false;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsPasswordChange']) &&
          resource.data.get('needsPasswordChange', false) == true &&
          request.resource.data.needsPasswordChange == false
        )
      );
    }

    match /aziende/{companyId}/dipendenti/{dipendenteId} {
      allow read: if isAuthenticated() && (get(/databases/$(database)/documents/aziende/$(companyId)/utenti/$(request.auth.uid)).data.dipendente_id == dipendenteId || isAdmin() || isImpiegata() || isSoel());
      allow write: if isAuthenticated() && (isAdmin() || isImpiegata());
    }

    match /aziende/{companyId}/settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /aziende/{companyId}/tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
      
      match /punti_consegna/{puntoId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isAdmin() || isImpiegata());
      }

      match /configurazioni/{configId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && isAdmin();
      }
    }
    
    match /aziende/{companyId}/mezzi/{mezzoId} {
      allow read, write: if isAuthenticated();
    }

    match /aziende/{companyId}/giustificativi/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isImpiegata());
    }

    match /aziende/{companyId}/presenze/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /mezzi/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /progetti/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /giustificativi/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /presenze/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Regole per il nuovo sistema Tenant (DNR)
    match /customers/{tenant}/{collection=**} {
      allow read, write: if isAuthenticated();
    }

    match /clienti/{tenant}/{collection=**} {
      allow read, write: if isAuthenticated();
    }

    // Legacy (mantenute per compatibilita, da rimuovere in futuro)
    match /mappatura/{docId} { allow read, write: if isAuthenticated(); }
    match /articoli/{docId} { allow read, write: if isAuthenticated(); }
    match /viaggi/{document=**} { allow read, write: if isAuthenticated(); }
    match /ddt/{docId} { allow read, write: if isAuthenticated(); }
  }
}
